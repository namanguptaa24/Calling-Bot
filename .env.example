# TEMPLATE — ismein kabhi asli values mat daalna.
# Ye file commit hoti hai. Asli values .env mein (gitignored),
# aur production mein Railway ke environment variables mein.

# ─────────────────────────────────────────────────────────────
# Postgres — humari copy. Yahi sab kuch chalata hai.
# ─────────────────────────────────────────────────────────────
# Railway ke andar se: ${{Postgres.DATABASE_URL}}
# Laptop se: Variables tab ka DATABASE_PUBLIC_URL
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# cPanel MySQL — SIRF sync ke liye, aur SIRF SELECT chalti hai
# ─────────────────────────────────────────────────────────────
# Inhe Railway ke env variables mein daalo, laptop ki file mein nahi.
# Khaali chhodoge to sync skip ho jaayegi; server chalta rahega aur
# briefing purani copy pe khud mana kar degi.
#
# Behtar: cPanel mein ek naya user banao jise sirf SELECT ho.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# ─────────────────────────────────────────────────────────────
# OpenAI — sirf task description ko bolne layak chhota karne ke liye
# ─────────────────────────────────────────────────────────────
# Isko numbers, naam ya tareekhein bheji hi nahi jaati (polish.ts).
# Khaali chhodoge to briefing chalegi, bas truncation ke saath.
OPENAI_API_KEY=
# POLISH_MODEL=gpt-4.1-mini

# ─────────────────────────────────────────────────────────────
# Vapi — call karne ke liye
# ─────────────────────────────────────────────────────────────
# Assistant Vapi dashboard mein EK BAAR banao jiska firstMessage
# sirf  {{script}}  ho. Awaaz aur bhasha wahin set karo.
# Phone number apne Twilio account se import karna padega —
# free Vapi number pe outbound hai hi nahi.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Call kisko jaaye. public.allowed_caller table mein rows hon to
# wo jeet jaati hai; ye sirf fallback hai. E.164: +919876543210
BRIEFING_TO=

# ─────────────────────────────────────────────────────────────
# Schedule (IST)
# ─────────────────────────────────────────────────────────────
# BRIEFING_CRON=0 10 * * 1-6    # Mon-Sat subah 10 baje
# SYNC_CRON=*/15 * * * *
# TZ_NAME=Asia/Kolkata
